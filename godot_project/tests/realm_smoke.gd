extends SceneTree
var checks=0
func check(ok: bool,message: String) -> void:
    checks+=1
    if not ok:
        push_error("REALM FAIL: "+message)
        quit(1)

func _initialize() -> void:
    call_deferred("run")

func run() -> void:
    var session=ClassDB.instantiate("PolyEcSession")
    check(session.realm_schema()=="realm-v6","native core schema")
    var paths=[]
    var hashes=[]
    for family in ["governance","economic","civilian"]:
        var base=ProjectSettings.globalize_path("res://models/realm-v6/"+family+"/")
        var manifest=JSON.parse_string(FileAccess.get_file_as_string(base+"manifest.json"))
        paths.append(base+family+".onnx")
        hashes.append(manifest.sha256)
    check(session.realm_load(paths,hashes,37,10000),"three native models load")
    check(session.realm_paused(),"interactive load starts paused")
    var v=session.realm_snapshot(1)
    check(v.persons==10000,"individual count")
    check(v.edges>19000,"real sparse relations")
    check(v.invariant,"opening accounting")
    check(not session.realm_step(1),"draft required")
    check(session.realm_draft(0,true),"reroll")
    check(not session.realm_draft(1,true),"only one reroll")
    v=session.realm_snapshot(1)
    check(session.realm_draft(v.cards[0],false),"choose")
    check(not session.realm_draft(v.cards[0],false),"apply once")
    check(session.realm_resume(),"resume loaded realm")
    check(not session.realm_paused(),"loaded realm resumed")
    var money=session.realm_snapshot(1).money
    session.set_active(true)
    var fixture_path="res://tests/realm_expected.json"
    for arg in OS.get_cmdline_user_args():
        if arg.begins_with("--fixture-file="): fixture_path=arg.trim_prefix("--fixture-file=")
    var fixture=JSON.parse_string(FileAccess.get_file_as_string(fixture_path))
    check(fixture is Array and fixture.size()==64,"native64-day fixture loaded")
    for day in range(64):
        check(session.realm_step(1),"learned day "+str(day))
        v=session.realm_snapshot(1)
        check(v.invariant and v.money==money,"funded population decisions")
        check(v.fingerprint==fixture[day].fingerprint,"native world fingerprint day "+str(day))
        check(v.decisions==fixture[day].decisions,"native committed decisions day "+str(day))
        check(v.alive==fixture[day].alive,"native lifetime transition day "+str(day))
        check(v.money==fixture[day].money,"native ledger day "+str(day))
    check(v.inferences>10000,"actual per-person inference, not empty records")
    var path=ProjectSettings.globalize_path("user://realm-smoke.polyec")
    check(session.realm_pause(),"pause before save")
    check(session.realm_save(path,false),"save world and policy memory")
    var saved=session.realm_snapshot(1).fingerprint
    var saved_revision=session.realm_pause_revision()
    check(session.realm_resume(),"resume after save")
    check(session.realm_step(1),"advance after save")
    var next=session.realm_snapshot(1).fingerprint
    check(next!=saved,"world advances")
    check(session.realm_save(path,true),"load exact")
    check(session.realm_snapshot(1).fingerprint==saved,"restore world")
    check(session.realm_paused(),"restore normalizes to paused")
    check(session.realm_pause_revision()==saved_revision,"restore keeps saved revision")
    check(session.realm_resume(),"resume restored core")
    check(session.realm_step(1),"advance after restore")
    check(session.realm_snapshot(1).fingerprint==next,"same sampled actions after restore")
    var manual_day=session.realm_snapshot(1).day
    check(session.realm_pause(),"pause for manual step")
    check(session.realm_step_one_day(),"manual step while paused")
    check(session.realm_snapshot(1).day==manual_day+1,"manual step advances while paused")
    check(session.realm_paused(),"manual step leaves paused")
    check(session.realm_resume(),"resume after manual step")
    var norm_path=ProjectSettings.globalize_path("user://realm-smoke-normalize.polyec")
    var norm_revision=session.realm_pause_revision()
    check(session.realm_save(norm_path,false),"save unpaused before normalized restore")
    check(session.realm_pause(),"pause live for normalized parity")
    check(session.realm_resume(),"resume live for normalized parity")
    check(session.realm_step(1),"advance live for normalized parity")
    var norm_next=session.realm_snapshot(1).fingerprint
    check(session.realm_save(norm_path,true),"load unpaused save")
    check(session.realm_paused(),"unpaused save restore normalizes to paused")
    check(session.realm_pause_revision()==norm_revision+1,"unpaused save restore revision")
    check(session.realm_resume(),"resume normalized restore")
    check(session.realm_step(1),"advance normalized restore")
    check(session.realm_snapshot(1).fingerprint==norm_next,"normalized restore parity")
    check(session.realm_save(path,false),"overwrite save keeps backup")
    var file=FileAccess.open(path,FileAccess.WRITE)
    file.store_string("corrupt")
    file.close()
    var stable=session.realm_snapshot(1).fingerprint
    check(not session.realm_save(path,true),"corrupt save rejected")
    check(session.realm_snapshot(1).fingerprint==stable,"failed load atomic")
    session.set_active(false)
    check(not session.realm_step(1),"inactive no time progress")
    session.set_active(true)
    check(not session.realm_command(0,1),"invalid player actor")
    var app=load("res://main.tscn").instantiate()
    root.add_child(app)
    await process_frame
    app._open_realm()
    await process_frame
    check(app.realm_panel.visible,"realm panel opens")
    var ui=app.session.realm_snapshot(1)
    check(ui.loaded,"UI session loaded models")
    check(app.session.realm_draft(ui.cards[0],false),"UI session chooses draft")
    app.realm_panel.refresh()
    app.realm_panel.toggle_run()
    check(app.realm_panel.running,"run toggle resumes")
    check(not app.session.realm_paused(),"run toggle resumed core")
    app.realm_panel._notification(Control.NOTIFICATION_APPLICATION_FOCUS_OUT)
    check(not app.realm_panel.running,"focus loss stops loop")
    check(app.session.realm_paused(),"focus loss pauses core")
    app.realm_panel.show_guide()
    check(not app.realm_panel.running,"guide pauses")
    for child in app.realm_panel.get_children():
        if child is AcceptDialog:
            child.queue_free()
    app.session.set_active(true)
    var manual_ui_day=app.session.realm_snapshot(1).day
    app.realm_panel.step_day()
    check(app.session.realm_snapshot(1).day==manual_ui_day+1,"manual UI step advances while paused")
    check(not app.realm_panel.running,"manual UI step leaves stopped")
    check(app.session.realm_paused(),"manual UI step leaves paused")
    app.realm_panel.save_path=ProjectSettings.globalize_path("user://realm-ui-smoke.polyec")
    var ui_saved=app.session.realm_snapshot(1).fingerprint
    app.realm_panel.save_game()
    check(FileAccess.file_exists(app.realm_panel.save_path),"UI save writes file")
    check(not app.realm_panel.running,"UI save stops loop")
    check(app.session.realm_paused(),"UI save leaves paused")
    app.realm_panel.toggle_run()
    app.realm_panel.advance_automatic_day()
    check(app.session.realm_snapshot(1).fingerprint!=ui_saved,"UI run advances world")
    app.realm_panel.load_game()
    check(app.session.realm_snapshot(1).fingerprint==ui_saved,"UI load restores saved world")
    check(not app.realm_panel.running,"UI load stops loop")
    check(app.session.realm_paused(),"UI load leaves paused")
    app.realm_panel.toggle_run()
    var running_day=app.session.realm_snapshot(1).day
    app.realm_panel.step_day()
    check(app.session.realm_snapshot(1).day==running_day+1,"manual UI step advances from run")
    check(not app.realm_panel.running,"manual UI step stops running loop")
    check(app.session.realm_paused(),"manual UI step pauses running core")
    app.realm_panel.toggle_run()
    check(app.realm_panel.running,"run before long frame")
    app.realm_panel._process(0.5)
    check(not app.realm_panel.running,"long frame stops loop")
    check(app.session.realm_paused(),"long frame pauses core")
    app.realm_panel.toggle_run()
    check(app.realm_panel.running,"run before app focus loss")
    app._notification(Control.NOTIFICATION_APPLICATION_FOCUS_OUT)
    check(not app.realm_panel.running,"app focus loss stops loop")
    check(app.session.realm_paused(),"app focus loss pauses core")
    app._notification(Control.NOTIFICATION_APPLICATION_FOCUS_IN)
    check(not app.realm_panel.running,"app focus regain leaves loop stopped")
    check(app.session.realm_paused(),"app focus regain leaves core paused")
    var paused_session=app.session
    app.realm_panel.session=ClassDB.instantiate("PolyEcSession")
    app.realm_panel.running=true
    app.realm_panel._process(0.5)
    check(app.realm_panel.visible,"long frame failure keeps panel visible")
    check(not app.realm_panel.running,"long frame failure stops loop")
    check(app.realm_panel.feedback.text=="Không tạm dừng được lõi Realm","long frame failure keeps pause error")
    app.realm_panel.close_panel()
    check(app.realm_panel.visible,"close failure keeps panel visible")
    check(app.realm_panel.feedback.text=="Không tạm dừng được lõi Realm","close failure keeps pause error")
    app.realm_panel.back_to_map()
    check(app.realm_panel.visible,"back failure keeps panel visible")
    check(app.realm_panel.feedback.text=="Không tạm dừng được lõi Realm","back failure keeps pause error")
    app.realm_panel.session=paused_session
    app.realm_panel.back_to_map()
    check(not app.realm_panel.visible,"back hides after pause")
    check(app.session.realm_paused(),"back leaves core paused")
    app.realm_panel.show()
    app.realm_panel.close_panel()
    check(not app.realm_panel.visible,"realm panel closes")
    check(app.session.realm_paused(),"realm panel close leaves core paused")
    app.queue_free()
    app=null
    session=null
    await process_frame
    await process_frame
    print("REALM SMOKE: ",checks,"/",checks," checks passed")
    quit(0)

config_version=5
[application]
config/name="PolyEc · Hai lãnh thổ"
run/main_scene="res://main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="PolyEcRebuild"
config/features=PackedStringArray("4.5", "GL Compatibility")
[display]
window/size/viewport_width=1360
window/size/viewport_height=900
window/size/window_width_override=1360
window/size/window_height_override=900
window/stretch/mode="canvas_items"
[rendering]
renderer/rendering_method="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.035,0.065,0.075,1)

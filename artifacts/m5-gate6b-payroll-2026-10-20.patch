+def save(name, world, bundle="migration-v16", note=""):
+    text = world.serialize(bundle)
+    assert text.startswith("POLYEC_REALM_16 ") and world.invariant()
+    path = folder / (name + ".save")
+    path.write_text(text, encoding="utf-8")
